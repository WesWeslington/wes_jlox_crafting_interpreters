// Testing CheckEqual
CheckEqual(1, 1, "CheckEqual integer test");
CheckEqual(true, true, "CheckEqual boolean test");
CheckEqual("test", "test", "CheckEqual string test");
CheckNotEqual(false, true, "CheckNotEqual test");

CheckEqual(counter(), 3, "Local Functions Test");
CheckEqual("Hello World Gazpacho", HelloWorld("Gazpacho"), "Single parameter test");

CheckEqual(round(loxSleepTestDuration), round(sleepTestDuration), "lox Sleep test");
CheckEqual(round(nativeSleepTestDuration), round(nativeSleepTestActualDuration), "native sleep test");

